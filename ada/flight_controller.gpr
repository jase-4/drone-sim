with "aunit";
with "config/flight_controller_config.gpr";
project Flight_Controller is

   for Source_Dirs use ("src/", "config/","tests/");
   for Object_Dir use "obj/" & Flight_Controller_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
  for Main use ("flight_controller.adb");

   package Compiler is
      for Default_Switches ("Ada") use Flight_Controller_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flight_Controller;
